__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.DS_Store

# reproducible build artefacts
cache/
data/

# Renders are regenerable scratch, except the shareable GIF and the two stills
# behind it, which are deliverables.
renders/*
!renders/gif/
renders/gif/*
!renders/gif/frame_switch.gif

# Results are ignored by default -- a timestamped run directory is scratch.
# The two that are actual claims are tracked, because a claim that lives only
# in an untracked file is not a claim anyone can check.
results/*
!results/sensitivity/
!results/sensitivity_unenriched/
!results/robustness/
!results/frame_probe/
!results/synthetic_example/

# The probe's raw answers and its keymap are evidence, not scratch -- they cannot
# be regenerated, only re-collected. The trial files can (from the pairs plus the
# scene cache) and are 1.2 MB of duplicated scene listings, so they stay out.
!results/self_probe/
!results/self_probe_v2/
results/self_probe/trials/
results/self_probe_v2/trials/
