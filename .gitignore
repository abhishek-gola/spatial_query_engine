renders/

# Results are ignored by default -- a timestamped run directory is scratch.
# The two that are actual claims are tracked, because a claim that lives only
# in an untracked file is not a claim anyone can check.
results/*
!results/sensitivity/
!results/robustness/
!results/synthetic_example/
